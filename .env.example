# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=
DB_SSL_CA=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=
GOOGLE_CLIENT_ID=

# MyMemory (optional contact email; raises the free quota)
MYMEMORY_EMAIL=

# Brevo (transactional email); fill these in your own .env only
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Salita Quest

# Cloudinary (audio files)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
